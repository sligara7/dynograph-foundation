    {
      "node_type": "Interface",
      "node_id": "ifc:graph-api",
      "properties": {
        "auth": "unspecified",
        "designation": "published",
        "medium": "library",
        "name": "Graph algorithms API",
        "operations": "centrality, connected components, community detection (Leiden), shortest paths, max flow",
        "paradigm": "synchronous",
