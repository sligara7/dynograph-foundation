    {
      "node_type": "Component",
      "node_id": "cmp:cluster",
      "properties": {
        "kind": "module",
        "level": "component",
        "location": "crates/dynograph-cluster",
        "name": "dynograph-cluster",
        "provenance": "inferred",
        "purpose": "Density-based clustering (DBSCAN) over a PRECOMPUTED distance matrix. Matrix in, labels out — it deliberately does not compute distances, the same way it does not produce vectors.",
        "status": "realized",
        "tier": "operational"
      }
    },
    {
      "node_type": "Component",
      "node_id": "cmp:core",
      "properties": {
        "kind": "module",
        "level": "component",
        "location": "crates/dynograph-core",
        "name": "dynograph-core",
        "provenance": "inferred",
        "purpose": "The schema model that drives the entire engine: Schema, NodeTypeDef, EdgeTypeDef, Value, DynoError, and YAML/JSON parse plus validation. A schema is a RUNTIME description of what nodes and edges may exist — which is what lets one binary serve any domain.",
        "status": "realized",
        "tier": "operational"
      }
    },
    {
      "node_type": "Component",
      "node_id": "cmp:game",
      "properties": {
        "kind": "module",
        "level": "component",
        "location": "crates/dynograph-game",
        "name": "dynograph-game",
        "provenance": "inferred",
        "purpose": "Closed-form normal-form game-theory analysis: dominant strategies, pure-strategy Nash equilibria, Pareto optimality, and the prisoner's-dilemma classification.",
        "status": "realized",
        "tier": "operational"
      }
    },
    {
      "node_type": "Component",
      "node_id": "cmp:graph",
      "properties": {
        "kind": "module",
        "level": "component",
        "location": "crates/dynograph-graph",
        "name": "dynograph-graph",
        "provenance": "inferred",
        "purpose": "Domain-neutral graph-theory algorithms over a densely-indexed in-memory graph: centrality, components, communities, paths and flow. Every algorithm is EXACT — no approximate or streaming variants — because consumer graphs are small.",
        "status": "realized",
        "tier": "operational"
      }
    },
    {
      "node_type": "Component",
      "node_id": "cmp:resolution",
      "properties": {
        "kind": "module",
        "level": "component",
        "location": "crates/dynograph-resolution",
        "name": "dynograph-resolution",
        "provenance": "inferred",
        "purpose": "Three-tier entity resolution — auto-merge above the high threshold, vector tiebreaker in the middle band, new entity below the low one — with a source-aware path that reserves auto-merge for name-to-name evidence.",
        "status": "realized",
        "tier": "operational"
      }
    },
    {
      "node_type": "Component",
      "node_id": "cmp:service",
      "properties": {
        "kind": "module",
        "level": "component",
        "location": "crates/dynograph-service",
        "name": "dynograph-service",
        "provenance": "inferred",
        "purpose": "The axum HTTP service and the `dynograph` binary: a multi-graph registry, pluggable auth, the /v1 REST surface, operational probes, Prometheus metrics, and a generated OpenAPI contract. By far the largest crate in the workspace.",
        "status": "realized",
        "tier": "operational"
      }
    },
    {
      "node_type": "Component",
      "node_id": "cmp:storage",
      "properties": {
        "kind": "module",
        "level": "component",
        "location": "crates/dynograph-storage",
        "name": "dynograph-storage",
        "provenance": "inferred",
        "purpose": "Schema-validated node and edge persistence: column families for nodes, edges, adjacency and the reverse index; MessagePack values; graph isolation so many graphs share one instance; atomic batch writes; iterator scans; a read cache; and the optional full-text mirror.",
        "status": "realized",
        "tier": "operational"
      }
    },
    {
      "node_type": "Component",
      "node_id": "cmp:text",
