        "level": "component",
        "location": "crates/dynograph-text",
        "name": "dynograph-text",
        "provenance": "inferred",
        "purpose": "Tantivy-backed BM25 keyword index behind a small storage-agnostic API. Knows nothing about schemas or graphs: callers pass already-extracted (graph, node_type, node_id, fields) and get scored node ids back.",
        "status": "realized",
        "tier": "operational"
      }
    },
