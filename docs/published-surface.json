    {
      "node_type": "Interface",
      "node_id": "ifc:schema-doc",
      "properties": {
        "auth": "unspecified",
        "designation": "published",
        "error_model": "DynoError::Validation naming the node type and property",
        "medium": "data",
        "name": "Schema document (YAML/JSON)",
        "operations": "parse, validate; POST /v1/graphs to configure a graph",
        "paradigm": "batch",
        "payload_format": "json",
        "payload_schema": "dynograph_core::Schema — node_types, edge_types, property flags (type/required/range/enum/default, indexed, fulltext), embedding_field, resolution rules",
        "provenance": "inferred",
        "spec": "THE central contract of the whole workspace. Each declaration is what TURNS ON a capability: `indexed` enables scans and where-prefilters, `fulltext` enables keyword search, `embedding_field` enables vector similarity, `resolution` enables dedup. The engine has no hardcoded domain types — only the ones a schema names.",
        "transport_security": "unspecified"
      }
    },
    {
      "node_type": "Interface",
      "node_id": "ifc:storage-api",
      "properties": {
        "auth": "unspecified",
        "designation": "published",
        "medium": "library",
        "name": "StorageEngine Rust API",
        "operations": "create/read/update/delete nodes and edges, adjacency and index scans, atomic batches, embedding sidecar operations, full-text mirroring",
        "paradigm": "synchronous",
        "payload_format": "unspecified",
        "provenance": "inferred",
        "spec": "The embedded-library entry point: `StorageEngine::new_in_memory(schema)` or a RocksDB path, then typed CRUD validated against the schema. This is the contract reflow2 and storyflow are built on, so its stability matters more than its elegance.",
        "transport_security": "unspecified"
      }
    },
    {
      "node_type": "Interface",
      "node_id": "ifc:text-api",
      "properties": {
        "auth": "unspecified",
        "designation": "published",
        "medium": "library",
        "name": "TextIndex API",
        "operations": "upsert, delete, search, commit/reload",
        "paradigm": "synchronous",
        "payload_format": "unspecified",
        "provenance": "inferred",
        "spec": "Index a node's full-text fields, remove it, and run tokenized BM25 keyword search. Storage-agnostic: callers pass (graph, node_type, node_id, fields) and get scored node ids back. Since v0.11.0 a multi-term query is a RANKED DISJUNCTION rather than a conjunction — a document must contain at least one token, and results come back in descending BM25 order.",
        "transport_security": "unspecified"
      }
    },
