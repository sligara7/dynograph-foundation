    {
      "node_type": "Project",
      "node_id": "prj:dynograph-foundation",
      "properties": {
        "description": "Rust workspace of domain-agnostic foundation crates for graph-based projects: schema-driven graph storage on RocksDB, HNSW vector search, BM25 full-text, entity resolution, pure graph/game/cluster math, and an HTTP service over all of it. Usable as embedded library crates or as the `dynograph` binary. Deliberately domain-neutral — extractors, schemas and servers for a domain live in CONSUMER projects (reflow2, storyflow) and depend on these crates by git tag.",
        "mode": "flexible",
        "name": "dynograph-foundation",
        "status": "active"
