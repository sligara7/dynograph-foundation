        "endpoint": "/v1 (default bind 127.0.0.1:8080)",
        "error_model": "JSON error body; 501 for routes whose build feature is off — the route and its OpenAPI entry always exist, so the contract does not change with the feature set",
        "medium": "REST",
        "name": "/v1 REST API",
        "operations": "80 operations across graph lifecycle, schema, nodes, edges, embeddings, search, primitives, algo/* and util/*",
        "paradigm": "synchronous",
        "payload_format": "json",
        "payload_schema": "docs/openapi.json (OpenAPI 3.1, generated from the handlers)",
