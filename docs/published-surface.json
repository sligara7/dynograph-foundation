      "node_id": "ifc:ops-probes",
      "properties": {
        "auth": "none",
        "designation": "published",
        "endpoint": "/health, /ready, /metrics, /buildinfo, /openapi.json",
        "error_model": "HTTP status only",
        "medium": "REST",
        "name": "Operational probes and metrics",
        "operations": "GET only",
        "paradigm": "synchronous",
        "payload_format": "json",
        "provenance": "inferred",
        "spec": "Public and unauthenticated by design, because an orchestrator's liveness check and a Prometheus scrape cannot hold a credential. /ready is deliberately distinct from /health. /metrics is Prometheus text format; /buildinfo carries version and git SHA.",
        "transport_security": "none"
      }
    },
    {
